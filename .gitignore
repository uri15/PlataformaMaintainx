# ==========================================================
# PLATAFORMA PARK CMMS — Reglas de Exclusión de Git
# Protege datos sensibles, archivos pesados y secretos de entorno
# ==========================================================

# 1. Dependencias de desarrollo y producción
node_modules/
package-lock.json

# 2. Variables de entorno y secretos privados
.env
.env.local
.env.*.local

# 3. Base de datos local activa (con contraseñas y datos operativos reales)
# La plantilla limpia para nuevos despliegues es: src/data/cmms_db.example.json
src/data/cmms_db.json
db/

# 4. Archivos multimedia y evidencias subidas por usuarios
uploads/*
!uploads/.gitkeep

# 5. Respaldos zip y copias de seguridad de desarrollo
*.zip
*.tar.gz
*.rar
*.7z
*.bak
backups/
temp_backup/
scratch/
src/bundle.jsx.bak

# 6. Registros y logs de ejecución
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. Configuraciones de editor y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# 8. Archivos auxiliares de pruebas locales y cache de Python
test_rbac.py
pyrightconfig.json
__pycache__/
*.py[cod]
